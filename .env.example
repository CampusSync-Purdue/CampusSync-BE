PORT=5050
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Comma-separated browser origins allowed to call this API.
# Leave unset to allow the usual local Vite ports (5173, 5174, 5175).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL Docker configuration
POSTGRES_DB=campussync
POSTGRES_USER=campussync_app
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://campussync_app:replace-with-a-strong-local-password@localhost:5432/campussync

# First administrator bootstrap
ADMIN_NAME=replace-with-admin-name
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-strong-admin-password