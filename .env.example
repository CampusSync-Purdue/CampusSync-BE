PORT=5050
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Comma-separated browser origins allowed to call this API.
# Leave unset to allow the usual local Vite ports (5173, 5174, 5175).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Longest a single reservation may run, in minutes. Optional; defaults to
# 180 (three hours). A malformed or non-positive value falls back to the
# default rather than removing the limit.
# MAX_RESERVATION_DURATION_MINUTES=180

# PostgreSQL Docker configuration
POSTGRES_DB=campussync
POSTGRES_USER=campussync_app
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://campussync_app:replace-with-a-strong-local-password@localhost:5432/campussync

# Used only by npm test. Create it with ./dev-env postgres test-db.
# The database name must end in _test; tests truncate test data.
TEST_DATABASE_URL=postgresql://campussync_app:replace-with-a-strong-local-password@localhost:5432/campussync_test

# Optional. IANA time zone for opening hours and booking rules.
# CAMPUS_TIMEZONE=America/Indiana/Indianapolis

# First administrator bootstrap
ADMIN_NAME=replace-with-admin-name
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-strong-admin-password


# --------------------------------------------------
# CSYNC-29 — Forgot Password / Password Reset
# --------------------------------------------------

# Frontend URL where users create a new password.
#
# Local development uses the Vite frontend.
# Production must use the deployed HTTPS frontend URL.
PASSWORD_RESET_URL=http://localhost:5173/reset-password


# --------------------------------------------------
# SMTP Email Configuration
# --------------------------------------------------

# Used to send password-reset emails.
#
# Configure these variables in your local .env file
# after the team selects an SMTP/email provider.
#
# Never commit real SMTP credentials to Git.

# SMTP server hostname
# SMTP_HOST=smtp.example.com

# SMTP port
# 587 = STARTTLS
# 465 = TLS immediately
# SMTP_PORT=587

# SMTP authentication credentials
# SMTP_USER=replace-with-smtp-username
# SMTP_PASS=replace-with-smtp-password

# Sender address shown in password-reset emails
# SMTP_FROM="CampusSync <no-reply@example.com>"


# --------------------------------------------------
# Password Reset Security
# --------------------------------------------------

# Password-reset tokens are:
# - Generated using cryptographically secure randomness.
# - Stored as SHA-256 hashes, never plaintext.
# - Valid for 30 minutes.
# - Single-use.
# - Invalidated after successful password changes.
#
# Successful password resets also increment the user's
# session version, invalidating previously issued JWTs.
#
# Password-reset endpoints are protected by rate limiting.
#
# The password-reset email service requires an SMTP
# provider before real emails can be delivered.