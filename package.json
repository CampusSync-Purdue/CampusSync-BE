    "luxon": "^3.7.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "0.31.11",
